<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodingAgentAccountSwitcher.Core\CodingAgentAccountSwitcher.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>CodingAgentAccountSwitcher</AssemblyName>
    <AssemblyTitle>Coding Agent Account Switcher</AssemblyTitle>
    <RootNamespace>CodingAgentAccountSwitcher.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CodingAgentAccountSwitcher.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Coding Agent Account Switcher contributors</Authors>
    <Product>Coding Agent Account Switcher</Product>
    <Description>An unofficial local Windows account and API configuration switcher for Codex, Claude Code, and OpenCode.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CodingAgentAccountSwitcher.png" />
  </ItemGroup>

</Project>
