<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="Brush.Window.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFF8F9FD" />
        <GradientStop Offset="0.55" Color="#FFF1F4FA" />
        <GradientStop Offset="1" Color="#FFE5EAF5" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#DEFFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.GlassStrong" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.GlassHover" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Control" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.ControlHover" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="Brush.Toggle.TrackOff" Color="#FF9DA6B4" />
    <SolidColorBrush x:Key="Brush.Toggle.TrackOffBorder" Color="#FF8791A1" />
    <SolidColorBrush x:Key="Brush.Toggle.TrackOn" Color="#FF34B85A" />
    <SolidColorBrush x:Key="Brush.Toggle.TrackOnBorder" Color="#FF2B9F4C" />
    <SolidColorBrush x:Key="Brush.Toggle.Thumb" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Segmented.Track" Color="#FFE1E5EB" />
    <SolidColorBrush x:Key="Brush.Segmented.TrackBorder" Color="#FFC4CBD6" />
    <SolidColorBrush x:Key="Brush.Segmented.Hover" Color="#FFF0F2F6" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#24334155" />
