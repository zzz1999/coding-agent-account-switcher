<Window x:Class="CodingAgentAccountSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CodingAgentAccountSwitcher.App"
        mc:Ignorable="d"
        Title="Coding Agent Account Switcher"
        Language="en-US"
        Width="920"
        Height="700"
        MinWidth="780"
        MinHeight="610"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Family.Text}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="AccountCardTemplate" DataType="{x:Type local:AccountCardViewModel}">
            <Border Style="{StaticResource Style.AccountCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46"
                                Height="46"
                                CornerRadius="15"
                                Background="{DynamicResource Brush.Accent.Muted}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="{Binding Initials}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="12,2,10,0">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"
                                       Text="{Binding Name}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Style.Text.Caption}"
                                       Text="{Binding Subtitle}" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                Height="27"
                                Padding="10,0"
                                Background="{DynamicResource Brush.State.SuccessMuted}"
                                CornerRadius="{StaticResource Radius.Pill}">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.State.Success}"
                                       Text="{Binding StatusText}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,22,0,18">
                        <TextBlock Style="{StaticResource Style.Text.Caption}"
                                   Text="ENCRYPTED LOCAL SNAPSHOT" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Style.Text.Body}"
                                   Text="{Binding LastSavedText}" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource Style.Button.Secondary}"
                            AutomationProperties.Name="{Binding AutomationActionLabel}"
                            Click="SwitchAccount_Click"
                            Content="{Binding ActionLabel}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProcessRowTemplate" DataType="{x:Type local:RunningProcessViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource Brush.Surface.Control}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Small}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource Brush.State.WarningMuted}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{DynamicResource Brush.State.Warning}"
                                   Text="!" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Text="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.State.Warning}"
                               Text="{Binding StateText}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Ellipse Width="520"
                 Height="520"
                 Margin="-260,-220,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Fill="{DynamicResource Brush.Orb.Primary}"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="92" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="420"
                 Height="420"
                 Margin="0,0,-180,-180"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Fill="{DynamicResource Brush.Orb.Secondary}"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="96" />
            </Ellipse.Effect>
        </Ellipse>

        <Border Margin="22"
                Background="{DynamicResource Brush.Surface.Glass}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="28"
                Effect="{StaticResource Effect.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid Margin="18,0,8,0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                Background="{DynamicResource Brush.Accent.Muted}"
                                CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="AS" />
                        </Border>
                        <TextBlock Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Coding Agent Account Switcher" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeButton"
                                Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="Switch color theme"
                                Click="ThemeButton_Click"
                                Content="☾"
                                ToolTip="Switch color theme" />
                        <Button Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="Minimize"
                                Click="MinimizeButton_Click"
                                Content="—" />
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="Maximize"
                                Click="MaximizeButton_Click"
                                Content="□" />
                        <Button Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="Close"
                                Click="CloseButton_Click"
                                Content="×" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="34,24,34,26"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="820">
                        <TextBlock Style="{StaticResource Style.Text.Display}"
                                   Text="Switch accounts, keep your setup." />
                        <TextBlock MaxWidth="680"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource Style.Text.Body}"
                                   Text="Choose a saved login snapshot. Settings, MCP servers, skills, plugins, and project history stay exactly where they are."
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProviderSelector"
                                    Padding="4"
                                    Background="{DynamicResource Brush.Surface.Control}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CodexSegment"
                                                 GroupName="Provider"
                                                 IsChecked="True"
                                                 Style="{StaticResource Style.SegmentedItem}"
                                                 Checked="ProviderSegment_Checked"
                                                 Content="Codex" />
                                    <RadioButton x:Name="ClaudeSegment"
                                                 GroupName="Provider"
                                                 Style="{StaticResource Style.SegmentedItem}"
                                                 Checked="ProviderSegment_Checked"
                                                 Content="Claude Code" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="SaveCurrentLoginButton"
                                    Grid.Column="2"
                                    Style="{StaticResource Style.Button.Primary}"
                                    AutomationProperties.Name="Save current login"
                                    Click="SaveCurrentLogin_Click"
                                    Content="Save current login" />
                        </Grid>

                        <Grid Margin="0,28,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ProviderTitle"
                                           Style="{StaticResource Style.Text.Title}"
                                           Text="Codex accounts" />
                                <TextBlock x:Name="ProviderDescription"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource Style.Text.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Text="Authentication file: %USERPROFILE%\.codex\auth.json" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Height="28"
                                    Padding="11,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Accent.Muted}"
                                    CornerRadius="{StaticResource Radius.Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.State.Success}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Text="LOCAL ONLY" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <ItemsControl x:Name="AccountItems"
                                          ItemTemplate="{StaticResource AccountCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border x:Name="EmptyStatePanel"
                                    MinHeight="190"
                                    Margin="0,0,14,0"
                                    Padding="24"
                                    Background="{DynamicResource Brush.Surface.Control}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="EmptyStateTitle"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource Style.Text.Title}"
                                               Text="No saved logins yet" />
                                    <TextBlock x:Name="EmptyStateMessage"
                                               MaxWidth="500"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Style="{StaticResource Style.Text.Body}"
                                               Text="Sign in through the provider's official flow, close its apps, then save the current login. Repeat once for your second account."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,24,14,0"
                                Padding="16,14"
                                Background="{DynamicResource Brush.State.SuccessMuted}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28"
                                        Height="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.State.SuccessMuted}"
                                        CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.State.Success}"
                                               Text="✓" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="Only authentication changes" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource Style.Text.Caption}"
                                               Text="Credential snapshots remain encrypted for the current Windows user. The app never previews token contents."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="7"
                                     Height="7"
                                     Margin="0,0,9,0"
                                     Fill="{DynamicResource Brush.State.Success}" />
                            <TextBlock x:Name="StatusText"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource Style.Text.Caption}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Text="Ready. No authentication file is being changed." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Text="No telemetry" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ProcessDialogOverlay"
              Panel.ZIndex="20"
              AutomationProperties.Name="Process check required"
              Background="{DynamicResource Brush.Scrim}"
              Visibility="Collapsed">
            <Border Style="{StaticResource Style.Dialog}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <Border Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.State.WarningMuted}"
                            CornerRadius="15">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.State.Warning}"
                                   Text="!" />
                    </Border>
                    <TextBlock x:Name="ProcessDialogTitle"
                               Margin="0,18,0,0"
                               Style="{StaticResource Style.Text.Title}"
                               Text="Close running apps before switching" />
                    <TextBlock x:Name="ProcessDialogMessage"
                               Margin="0,8,0,0"
                               Style="{StaticResource Style.Text.Body}"
                               Text="The applications below may still be using the authentication file. Close them, then check again. No login file has been changed."
                               TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="220"
                                  Margin="0,18,0,10"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BlockingProcessItems"
                                      ItemTemplate="{StaticResource ProcessRowTemplate}" />
                    </ScrollViewer>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Style="{StaticResource Style.Button.Secondary}"
                                Click="CancelProcessDialog_Click"
                                Content="Cancel" />
                        <Button x:Name="RecheckButton"
                                Grid.Column="3"
                                Style="{StaticResource Style.Button.Primary}"
                                Click="RecheckProcesses_Click"
                                Content="Check again" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SaveProfileDialogOverlay"
              Panel.ZIndex="21"
              AutomationProperties.Name="Save current login"
              Background="{DynamicResource Brush.Scrim}"
              Visibility="Collapsed">
            <Border Style="{StaticResource Style.Dialog}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <Border Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Accent.Muted}"
                            CornerRadius="15">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="＋" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               Style="{StaticResource Style.Text.Title}"
                               Text="Save the current login" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Style.Text.Body}"
                               Text="Choose a local label such as Personal or Work. The app stores the authentication file as an opaque, DPAPI-encrypted snapshot and never reads the account identity inside it."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,20,0,7"
                               Style="{StaticResource Style.Text.Caption}"
                               Text="PROFILE LABEL" />
                    <TextBox x:Name="ProfileNameTextBox"
                             MaxLength="80"
                             Style="{StaticResource Style.TextBox}"
                             AutomationProperties.Name="Profile label"
                             TextChanged="ProfileNameTextBox_TextChanged"
                             KeyDown="ProfileNameTextBox_KeyDown" />
                    <TextBlock x:Name="ProfileNameValidationText"
                               Margin="2,7,0,0"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="{DynamicResource Brush.State.Danger}"
                               Style="{StaticResource Style.Text.Caption}"
                               Text="Enter a label."
                               Visibility="Collapsed" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Style="{StaticResource Style.Button.Secondary}"
                                Click="CancelSaveProfileDialog_Click"
                                Content="Cancel" />
                        <Button x:Name="ConfirmSaveProfileButton"
                                Grid.Column="3"
                                Style="{StaticResource Style.Button.Primary}"
                                Click="ConfirmSaveProfile_Click"
                                Content="Save encrypted snapshot" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ChangedLoginDialogOverlay"
              Panel.ZIndex="22"
              AutomationProperties.Name="Current login confirmation required"
              Background="{DynamicResource Brush.Scrim}"
              Visibility="Collapsed">
            <Border Style="{StaticResource Style.Dialog}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <Border Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.State.WarningMuted}"
                            CornerRadius="15">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.State.Warning}"
                                   Text="!" />
                    </Border>
                    <TextBlock x:Name="ChangedLoginDialogTitle"
                               Margin="0,18,0,0"
                               Style="{StaticResource Style.Text.Title}"
                               Text="Confirm the current login" />
                    <TextBlock x:Name="ChangedLoginDialogMessage"
                               Margin="0,8,0,0"
                               Style="{StaticResource Style.Text.Body}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14,12"
                            Background="{DynamicResource Brush.State.WarningMuted}"
                            CornerRadius="{StaticResource Radius.Small}">
                        <TextBlock x:Name="ChangedLoginSafetyText"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Text="No authentication file has been changed. Confirm only when the live login still belongs to the named profile."
                                   TextWrapping="Wrap" />
                    </Border>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Style="{StaticResource Style.Button.Secondary}"
                                Click="CancelChangedLoginDialog_Click"
                                Content="Cancel" />
                        <Button Grid.Column="3"
                                Style="{StaticResource Style.Button.Secondary}"
                                Click="SaveChangedLoginAsNew_Click"
                                Content="Save as new…" />
                        <Button x:Name="ConfirmChangedLoginButton"
                                Grid.Column="5"
                                Style="{StaticResource Style.Button.Primary}"
                                AutomationProperties.Name="Confirm current login and switch"
                                Click="ConfirmChangedLoginSwitch_Click"
                                Content="Confirm &amp; switch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
