    <SolidColorBrush x:Key="Brush.Surface.ControlHover" Color="#FF293443" />
    <SolidColorBrush x:Key="Brush.Toggle.TrackOff" Color="#FF566171" />
    <SolidColorBrush x:Key="Brush.Toggle.TrackOffBorder" Color="#FF6B7687" />
    <SolidColorBrush x:Key="Brush.Toggle.TrackOn" Color="#FF3BC866" />
