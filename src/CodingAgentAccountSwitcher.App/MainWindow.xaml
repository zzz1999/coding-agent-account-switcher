<Window x:Class="CodingAgentAccountSwitcher.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CodingAgentAccountSwitcher.App"
        mc:Ignorable="d"
        Title="{DynamicResource L.App.Title}"
        Width="920"
        Height="700"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Surface.Glass}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Family.Text}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="22"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Draw icons as vectors so rounded caps and joins stay consistent at every DPI. -->
        <Style x:Key="Style.Icon.RoundedPath" TargetType="Path">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="Style.SettingsToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource Brush.Toggle.TrackOff}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Toggle.TrackOffBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Track"
                                    Width="50"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                                <Border x:Name="Thumb"
                                        Width="24"
                                        Height="24"
                                        Margin="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Toggle.Thumb}"
                                        BorderBrush="{DynamicResource Brush.Toggle.ThumbBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12" />
                            </Border>
                            <Border x:Name="ToggleFocusRing"
                                    Width="50"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="15"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Toggle.TrackOn}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Toggle.TrackOnBorder}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleFocusRing" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToggleFocusRing" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing.OnToggle}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AccountCardTemplate" DataType="{x:Type local:AccountCardViewModel}">
            <Border Style="{StaticResource Style.AccountCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46"
                                Height="46"
                                CornerRadius="15"
                                Background="{DynamicResource Brush.Accent.Muted}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent.Foreground}"
                                       Text="{Binding Initials}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="12,2,10,0">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Cursor="Hand"
                                       Focusable="True"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"
                                       AutomationProperties.HelpText="{Binding RenameHint}"
                                       MouseLeftButtonDown="ProfileName_MouseLeftButtonDown"
                                       KeyDown="ProfileName_KeyDown"
                                       Text="{Binding Name}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Style.Text.Caption}"
                                       Text="{Binding Subtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Border Height="27"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.State.SuccessMuted}"
                                    CornerRadius="{StaticResource Radius.Pill}">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.State.Success}"
                                           Text="{Binding StatusText}" />
                            </Border>
                            <Button Width="32"
                                    Height="32"
                                    MinWidth="32"
                                    MinHeight="32"
                                    Margin="7,-2,0,0"
                                    Padding="0"
                                    Style="{StaticResource Style.Button.CloseIcon}"
                                    AutomationProperties.Name="{Binding DeleteAutomationLabel}"
                                    Click="DeleteProfileButton_Click">
                                <Viewbox Width="22"
                                         Height="22"
                                         FlowDirection="LeftToRight">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.1"
                                              Data="M7,7.5 V18 A2,2 0 0 0 9,20 H15 A2,2 0 0 0 17,18 V7.5 M4.5,7.5 H19.5 M9,4.5 H15 M9.5,11 V17 M14.5,11 V17" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,22,0,18">
                        <TextBlock Style="{StaticResource Style.Text.Caption}"
                                   Text="{DynamicResource L.Card.EncryptedSnapshot}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource Style.Text.Body}"
                                   Text="{Binding LastSavedText}" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource Style.Button.Secondary}"
                            AutomationProperties.Name="{Binding AutomationActionLabel}"
                            Click="SwitchAccount_Click"
                            Content="{Binding ActionLabel}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProcessRowTemplate" DataType="{x:Type local:RunningProcessViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{DynamicResource Brush.Surface.Control}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Small}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="32"
                            Background="{DynamicResource Brush.State.WarningMuted}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{DynamicResource Brush.State.Warning}"
                                   Text="!" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Text="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.State.Warning}"
                               Text="{Binding StateText}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainShell"
                Background="{DynamicResource Brush.Surface.Glass}"
                BorderThickness="0"
                CornerRadius="22">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid Margin="18,0,8,0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="34"
                               Height="34"
                               SnapsToDevicePixels="True"
                               Source="/Assets/CodingAgentAccountSwitcher.png"
                               Stretch="Uniform"
                               UseLayoutRounding="True" />
                        <TextBlock Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource L.App.Title}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeButton"
                                Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="{DynamicResource L.Window.Theme}"
                                Click="ThemeButton_Click"
                                ToolTip="{DynamicResource L.Window.Theme}">
                            <Grid Width="18" Height="18" FlowDirection="LeftToRight">
                                <Viewbox x:Name="ThemeMoonIcon"
                                         Width="18"
                                         Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M12,3 A6,6 0 0 0 21,12 A9,9 0 1 1 12,3 Z" />
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="ThemeSunIcon"
                                         Width="18"
                                         Height="18"
                                         Visibility="Collapsed">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L12,4 M12,20 L12,22 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 L4,12 M20,12 L22,12 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="{DynamicResource L.Window.Settings}"
                                Click="SettingsButton_Click"
                                ToolTip="{DynamicResource L.Window.Settings}">
                            <Viewbox Width="18"
                                     Height="18"
                                     FlowDirection="LeftToRight">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M9.594,3.94 C9.684,3.398 10.154,3 10.704,3 H13.296 C13.846,3 14.316,3.398 14.406,3.94 L14.619,5.221 C14.682,5.595 14.932,5.907 15.264,6.091 C15.338,6.131 15.411,6.174 15.484,6.218 C15.809,6.414 16.204,6.475 16.559,6.342 L17.776,5.886 C18.29,5.693 18.869,5.9 19.146,6.376 L20.442,8.623 C20.717,9.099 20.61,9.702 20.19,10.053 L19.194,10.88 C18.902,11.123 18.756,11.493 18.764,11.872 C18.766,11.957 18.766,12.042 18.764,12.127 C18.756,12.505 18.902,12.876 19.194,13.118 L20.189,13.946 C20.609,14.296 20.717,14.9 20.442,15.376 L19.146,17.623 C18.869,18.099 18.29,18.306 17.776,18.113 L16.559,17.657 C16.204,17.524 15.809,17.585 15.483,17.781 C15.411,17.825 15.337,17.868 15.263,17.909 C14.932,18.092 14.682,18.404 14.619,18.778 L14.406,20.059 C14.316,20.602 13.846,21 13.296,21 H10.704 C10.154,21 9.684,20.602 9.594,20.059 L9.381,18.778 C9.318,18.404 9.068,18.092 8.737,17.908 C8.663,17.868 8.59,17.825 8.517,17.781 C8.191,17.585 7.796,17.524 7.441,17.657 L6.224,18.113 C5.71,18.306 5.131,18.099 4.854,17.623 L3.558,15.376 C3.283,14.9 3.391,14.296 3.811,13.946 L4.806,13.119 C5.098,12.876 5.244,12.505 5.236,12.127 C5.234,12.042 5.234,11.957 5.236,11.872 C5.244,11.493 5.098,11.123 4.806,10.881 L3.811,10.053 C3.391,9.703 3.283,9.099 3.558,8.623 L4.854,6.376 C5.131,5.9 5.71,5.693 6.224,5.886 L7.441,6.342 C7.797,6.475 8.191,6.414 8.517,6.218 C8.589,6.174 8.663,6.131 8.737,6.09 C9.068,5.907 9.318,5.595 9.381,5.221 L9.594,3.94 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="{DynamicResource L.Window.Minimize}"
                                Click="MinimizeButton_Click">
                            <Viewbox Width="17"
                                     Height="17"
                                     FlowDirection="LeftToRight">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M5,12 L19,12" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.Name="{DynamicResource L.Window.Maximize}"
                                Click="MaximizeButton_Click">
                            <Grid Width="17" Height="17" FlowDirection="LeftToRight">
                                <Viewbox x:Name="MaximizeIcon"
                                         Width="17"
                                         Height="17">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M7,5 H17 A2,2 0 0 1 19,7 V17 A2,2 0 0 1 17,19 H7 A2,2 0 0 1 5,17 V7 A2,2 0 0 1 7,5 Z" />
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="RestoreIcon"
                                         Width="17"
                                         Height="17"
                                         Visibility="Collapsed">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M9,5 H17 A2,2 0 0 1 19,7 V15 A2,2 0 0 1 17,17 H16 M7,8 H14 A2,2 0 0 1 16,10 V17 A2,2 0 0 1 14,19 H7 A2,2 0 0 1 5,17 V10 A2,2 0 0 1 7,8 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Style.Button.CloseIcon}"
                                AutomationProperties.Name="{DynamicResource L.Window.Close}"
                                Click="CloseButton_Click">
                            <Viewbox Width="17"
                                     Height="17"
                                     FlowDirection="LeftToRight">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M7,7 L17,17 M17,7 L7,17" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="34,22,34,22"
                              FocusVisualStyle="{x:Null}"
                              HorizontalContentAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1280"
                                HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource Style.Text.Display}"
                                   Text="{DynamicResource L.Hero.Title}" />
                        <TextBlock MaxWidth="900"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource Style.Text.Body}"
                                   Text="{DynamicResource L.Hero.Description}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProviderSelector"
                                    Padding="4"
                                    Background="{DynamicResource Brush.Segmented.Track}"
                                    BorderBrush="{DynamicResource Brush.Segmented.TrackBorder}"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CodexSegment"
                                                 GroupName="Provider"
                                                 IsChecked="True"
                                                 Style="{StaticResource Style.SegmentedItem}"
                                                 Checked="ProviderSegment_Checked"
                                                 Content="{DynamicResource L.Provider.Codex}" />
                                    <RadioButton x:Name="ClaudeSegment"
                                                 GroupName="Provider"
                                                 Style="{StaticResource Style.SegmentedItem}"
                                                 Checked="ProviderSegment_Checked"
                                                 Content="{DynamicResource L.Provider.ClaudeCode}" />
                                    <RadioButton x:Name="OpenCodeSegment"
                                                 GroupName="Provider"
                                                 Style="{StaticResource Style.SegmentedItem}"
                                                 Checked="ProviderSegment_Checked"
                                                 Content="{DynamicResource L.Provider.OpenCode}" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="SaveCurrentLoginButton"
                                    Grid.Column="2"
                                    Style="{StaticResource Style.Button.Primary}"
                                    AutomationProperties.Name="{DynamicResource L.Action.SaveCurrentLogin}"
                                    Click="SaveCurrentLogin_Click"
                                    Content="{DynamicResource L.Action.SaveCurrentLogin}" />
                        </Grid>

                        <Grid Margin="0,24,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ProviderTitle"
                                           Style="{StaticResource Style.Text.Title}"
                                           Text="{DynamicResource L.Provider.Codex}" />
                                <TextBlock x:Name="ProviderDescription"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource Style.Text.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                     Height="28"
                                     Padding="11,0"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource Brush.State.SuccessMuted}"
                                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                     BorderThickness="1"
                                     CornerRadius="14">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.State.Success}" />
                                     <TextBlock VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.State.Success}"
                                                Text="{DynamicResource L.Badge.LocalOnly}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <ItemsControl x:Name="AccountItems"
                                          AlternationCount="2"
                                          ItemTemplate="{StaticResource AccountCardTemplate}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,14" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter Property="Margin" Value="0,0,7,14" />
                                            </Trigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter Property="Margin" Value="7,0,0,14" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border x:Name="EmptyStatePanel"
                                    MinHeight="176"
                                    Margin="0,0,0,14"
                                    Padding="24"
                                    Background="{DynamicResource Brush.Surface.Control}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="EmptyStateTitle"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource Style.Text.Title}"
                                               Text="{DynamicResource L.Empty.NoLogin.Title}" />
                                    <TextBlock x:Name="EmptyStateMessage"
                                               MaxWidth="500"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Style="{StaticResource Style.Text.Body}"
                                               Text="{DynamicResource L.Empty.NoLogin.Message}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,4,0,0"
                                Padding="16,13"
                                Background="{DynamicResource Brush.State.SuccessMuted}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28"
                                        Height="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.State.SuccessMuted}"
                                        CornerRadius="9">
                                    <Viewbox Width="16"
                                             Height="16"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             FlowDirection="LeftToRight">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource Style.Icon.RoundedPath}"
                                                  Stroke="{DynamicResource Brush.State.Success}"
                                                  StrokeThickness="2.2"
                                                  Data="M5,12.5 L10,17.5 L19,7" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{DynamicResource L.Security.Title}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource Style.Text.Caption}"
                                               Text="{DynamicResource L.Security.Message}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Brush.Divider}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,16,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
